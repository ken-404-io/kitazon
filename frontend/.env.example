REACT_APP_API_URL=http://localhost:5000

# ─── GCash Payment (plan upgrades) ───────────────────────────────────────────
# URL to your GCash QR code image (upload to any image host or your CDN)
REACT_APP_GCASH_QR_URL=https://your-cdn.com/gcash-qr.png
# GCash mobile number users will send payment to
REACT_APP_GCASH_NUMBER=09XXXXXXXXX
# Name shown on the GCash account
REACT_APP_GCASH_NAME=Your Name Here

# hCaptcha site key (https://www.hcaptcha.com — free tier available)
REACT_APP_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# ─── Affiliate / CPA Networks ────────────────────────────────────────────────
# Add each key you've obtained from the network's publisher dashboard.
# Only networks with keys present will appear as active offer walls.

# CPAlead — Publisher ID from https://cpalead.com → Publisher → Offerwall
REACT_APP_CPALEAD_PUB_ID=

# Lootably — App Token from https://lootably.com → Create App
REACT_APP_LOOTABLY_APP_TOKEN=

# OfferToro — Site ID from https://offertoro.com → Add Site
REACT_APP_OFFERTORO_SITE_ID=

# Adscend Media — Publisher ID from https://adscendmedia.com → Publisher
REACT_APP_ADSCEND_PUB_ID=

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon / PostgreSQL connection string (preferred)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Individual DB fields (fallback if DATABASE_URL not set)
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Must be at least 32 random characters — generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# hCaptcha (https://www.hcaptcha.com — free tier available)
# Leave blank in development to skip captcha verification
HCAPTCHA_SECRET=your-hcaptcha-secret-key

# Email / SMTP — leave blank to log emails to console in development
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM=Kitazon <noreply@yourdomain.com>

# ─── Affiliate / CPA Networks ────────────────────────────────────────────────
# Conversion rate and margin (defaults: 57 PHP per USD, 70% share to user)
USD_TO_PHP_RATE=57
AFFILIATE_USER_SHARE=0.70

# CPAlead — sign up at https://cpalead.com → Publisher → Offerwall
CPALEAD_SECRET=your_cpalead_postback_secret

# Lootably — sign up at https://lootably.com → Create App
LOOTABLY_SECRET=your_lootably_api_key

# OfferToro — sign up at https://offertoro.com → Add Site
OFFERTORO_SECRET=your_offertoro_secret_key

# Adscend Media — sign up at https://adscendmedia.com → Publisher
ADSCEND_SECRET=your_adscend_secret_key
